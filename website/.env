# 電梯監控系統配置文件
# 請根據您的需求修改以下設置

# 伺服器配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# MongoDB 資料庫配置
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=elevator_monitoring
MONGODB_COLLECTION_EVENTS=events
MONGODB_COLLECTION_USERS=users

# 注意事項：
# 1. 如果要從外網訪問，需要在路由器設置埠轉發
# 2. 確保防火牆允許指定埠號的連線
# 3. 生產環境建議使用 nginx 或 apache 作為反向代理
# 4. 確保 MongoDB 服務已啟動
